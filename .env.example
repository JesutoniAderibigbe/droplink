# ─── Client (Vite) ────────────────────────────────────────────────────────────
# Copy to .env.local for local dev. In Netlify, set these as site env vars.
# Only VITE_* values are bundled into the app, and all three are public.

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
# Local dev: "same-origin" makes the browser talk to Supabase through the Vite
# dev server's HTTPS proxy (needed for testing on a phone).
VITE_SUPABASE_URL=same-origin

# Supabase anon / publishable key (public; RLS protects the data).
# Local: `supabase status` → ANON_KEY.
VITE_SUPABASE_ANON_KEY=

# Web Push VAPID public key. Generate a pair with `npm run vapid`.
VITE_VAPID_PUBLIC_KEY=

# Local dev only: where the Vite proxy forwards Supabase requests.
SUPABASE_PROXY_TARGET=http://127.0.0.1:55321

# ─── Supabase Edge Function secrets ───────────────────────────────────────────
# NOT for .env.local. Locally put them in supabase/functions/.env (gitignored);
# in production: `supabase secrets set NAME=value`.

# VAPID key pair from `npm run vapid` (the public key is needed server side too).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@yourdomain.com
# VAPID_SUBJECT=mailto:admin@example.com

# Cloudflare Realtime TURN (dash.cloudflare.com → Realtime → TURN Server → Create).
# Without these, turn-credentials returns STUN only.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# Shared secret pg_cron sends to relay-cleanup. Must equal the Vault secret
# "droplink_cron_secret" (see README). Generate: openssl rand -hex 32
# CRON_SECRET=

# Comma-separated origins allowed to call the functions from a browser,
# e.g. https://droplink.netlify.app. Empty = reflect any origin (dev only).
# ALLOWED_ORIGINS=
